<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- silent self-updates on Android 12+ once this app is its own installer of record -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Android 11+ package visibility: without these, TTS engines (and their
         voice lists) are invisible to the app and tts.voices comes back empty -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.NovelDownloader"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".NovelListActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android share target: share a novel URL from any app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowserActivity"
            android:exported="false" />

        <activity
            android:name=".DocumentListActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".DocumentEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChapterListActivity"
            android:exported="false" />

        <activity
            android:name=".NovelSettingsActivity"
            android:exported="false" />

        <!-- Rotating must NOT recreate the reader: a rebuild runs onDestroy,
             which shuts the TTS engine down and stops the reading service.
             Handling these config changes in-place keeps playback going (the
             layout is orientation-agnostic; the text just re-wraps). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <activity
            android:name=".SpeechEditsActivity"
            android:exported="false" />

        <!-- Foreground service: downloads keep running with the screen off -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Foreground service: TTS keeps reading with the screen off.

             Headset buttons do NOT come through here. They go to the reader's
             media session, which is eligible for them because Silence keeps a
             player of ours running under our own UID.

             This service and an androidx MediaButtonReceiver used to carry a
             MEDIA_BUTTON filter between them, as the fallback for when no
             session can take a key. That route could never fire while a
             reader was alive: the system only remembers a receiver for a
             session it has already CHOSEN, so reaching the fallback meant
             having been the media-button session and then losing it — which
             happens when the session is released, in the same onDestroy that
             stops this service. Nothing was left to play or pause. -->
        <service
            android:name=".TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Foreground service: bulk compress/uncompress survives backgrounding -->
        <service
            android:name=".CompressService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- PackageInstaller session results for self-updates -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- "Install" on the update-ready notification -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

    </application>
</manifest>
