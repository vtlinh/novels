<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- silent self-updates on Android 12+ once this app is its own installer of record -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Android 11+ package visibility: without these, TTS engines (and their
         voice lists) are invisible to the app and tts.voices comes back empty -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.NovelDownloader"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android share target: share a novel URL from any app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowserActivity"
            android:exported="false" />

        <activity
            android:name=".NovelListActivity"
            android:exported="false" />

        <activity
            android:name=".ChapterListActivity"
            android:exported="false" />

        <!-- Rotating must NOT recreate the reader: a rebuild runs onDestroy,
             which shuts the TTS engine down and stops the reading service.
             Handling these config changes in-place keeps playback going (the
             layout is orientation-agnostic; the text just re-wraps). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <activity
            android:name=".SpeechEditsActivity"
            android:exported="false" />

        <!-- Foreground service: downloads keep running with the screen off -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Foreground service: TTS keeps reading with the screen off.

             The MEDIA_BUTTON filter is what androidx's MediaButtonReceiver
             forwards to; without a service advertising this action it throws.
             That pairing is a FALLBACK for when no session is available, not
             the route a press normally takes: a live press goes straight to
             the media session's callback. An earlier note here said the
             missing filter "is why headset play/pause did nothing" — it was
             not. See Silence: this app was never eligible for the buttons at
             all, because it never played audio under its own UID. -->
        <service
            android:name=".TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Foreground service: bulk compress/uncompress survives backgrounding -->
        <service
            android:name=".CompressService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- PackageInstaller session results for self-updates -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- "Install" on the update-ready notification -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Where the system sends media buttons when NO session can take
             them. Both this and the session route need the app to have been
             the media-button session at some point (the system only remembers
             a receiver for a session it has chosen), so this cannot be the
             thing that gets a press to a reader that is alive — by then the
             session itself has it. Kept as the fallback it is. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
