<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="@color/fg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/readerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/chaptersBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="≡"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/speechEditsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="✎&#xFE0E;"
                android:textSize="18sp"
                android:textColor="@color/fg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/settingsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="⚙&#xFE0E;"
                android:textSize="18sp"
                android:textColor="@color/fg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/readerScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/readerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:textSize="16sp"
                    android:textColor="@color/fg"
                    android:lineSpacingMultiplier="1.45"
                    android:textIsSelectable="true" />
            </ScrollView>

            <!-- transient status (e.g. "shaking") shown over the text -->
            <TextView
                android:id="@+id/readerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/err"
                android:background="@color/card"
                android:visibility="gone" />
        </FrameLayout>

        <!-- TTS footer: prev-paragraph / play / next-paragraph centered,
             voice settings on the right. The skip glyphs are Dingbats
             (like the pause bars) so they render in the text style and
             color everywhere instead of falling back to the emoji font. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ttsPrevBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="&#x276E;"
                    android:textSize="30sp"
                    android:textColor="@color/fg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/ttsPlayBtn"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:background="@drawable/bg_play_circle"
                    android:text="&#x25B6;&#xFE0E;"
                    android:textSize="26sp"
                    android:textColor="@color/bg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/ttsNextBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="&#x276F;"
                    android:textSize="30sp"
                    android:textColor="@color/fg"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- shown in place of the play button while the TTS engine is
                 still binding (tap = retry a given-up bind) -->
            <ProgressBar
                android:id="@+id/ttsSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/fg"
                android:visibility="gone" />

            <!-- ♪: monochrome, universally rendered, and reads as "audio" —
                 the voice/rate/pitch sheet lives behind it -->
            <TextView
                android:id="@+id/ttsSettingsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="&#x266A;"
                android:textSize="18sp"
                android:textColor="@color/fg"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- right-side inline chapter list -->
    <ListView
        android:id="@+id/chapterDrawerList"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/card"
        android:divider="@color/bg"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true"
        android:fastScrollAlwaysVisible="true" />
</androidx.drawerlayout.widget.DrawerLayout>
