<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="24sp"
                android:textColor="@color/fg"
                android:paddingEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textSize="22sp"
                android:textColor="@color/fg"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ══ Storage (download folder + compression) ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg" />

            <!-- Download folder: {Folder} {edit icon} -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download folder:"
                    android:textSize="14sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/folderLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/fg"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="No folder selected" />

                <TextView
                    android:id="@+id/folderBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎&#xFE0E;"
                    android:textSize="18sp"
                    android:textColor="@color/accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/compressCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="6dp"
                android:text="Compress my novels"
                android:textSize="14sp"
                android:textColor="@color/fg"
                app:buttonTint="@color/accent" />

            <TextView
                android:id="@+id/zipStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stores chapters as per-chapter gzip (~70% smaller). New downloads follow this setting; existing novels are converted in the background. Reading works either way."
                android:textSize="12sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- ══ Anthropic API key ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anthropic API key"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:hint="sk-ant-…"
                android:textSize="14sp"
                android:textColor="@color/fg"
                android:textColorHint="@color/muted"
                android:inputType="textPassword"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Used for chapter translation, which costs money — each translation is billed to your Anthropic account balance. Stored only on this device."
                android:textSize="12sp"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/apiKeyLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Get an API key ↗"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ══ Library ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Automatic status check"
                    android:textSize="14sp"
                    android:textColor="@color/fg" />

                <TextView
                    android:id="@+id/statusCheckDaysLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never"
                    android:textSize="14sp"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:minWidth="72dp"
                    android:gravity="end" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/statusCheckDaysSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="7"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"
                android:progressBackgroundTint="@color/input_stroke" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="When you open the app, check novels for new chapters if at least this many days have passed since the last automatic check. 0 = never. Same check as the Library's Check button."
                android:textSize="12sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- ══ Reading ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/keepAwakeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="6dp"
                android:text="Keep screen awake while reading aloud"
                android:textSize="14sp"
                android:textColor="@color/fg"
                app:buttonTint="@color/accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Stops the screen from dimming off on the reader while text-to-speech is playing."
                android:textSize="12sp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
