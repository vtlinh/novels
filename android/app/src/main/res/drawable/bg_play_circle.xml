<?xml version="1.0" encoding="utf-8"?>
<!-- the TTS footer's big round play/pause button: neutral, not accent —
     a colored fill was tried and asked off. The ring makes the circle
     read as a button against the card background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/btn_secondary" />
    <stroke
        android:width="1.5dp"
        android:color="@color/muted" />
</shape>
