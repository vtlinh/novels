<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always-dark theme matching the web app's fixed dark palette -->
    <style name="Theme.NovelDownloader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- Same box and glyph size for every toolbar icon. -->
    <style name="ToolbarIcon">
        <item name="android:layout_width">@dimen/toolbar_icon</item>
        <item name="android:layout_height">@dimen/toolbar_icon</item>
        <item name="android:padding">@dimen/toolbar_icon_padding</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/fg</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>

